NODE_ENV=development
PORT=4000

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=edtech_admin
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Auth — must match admin-panel's JWT_SECRET exactly
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Default superadmin, created automatically on first `npm run db:setup`
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@edtech.local
SUPERADMIN_PASSWORD=ChangeMe123!

# Origin allowed to call this API directly (the admin-panel app)
CORS_ORIGIN=http://localhost:3000

# Timezone that decides when a future-dated blog post goes live
CONTENT_TIMEZONE=Asia/Kolkata

# S3 — blog/event image uploads. Objects are written under content/, which
# needs a bucket policy allowing public read. AWS_S3_PUBLIC_URL is optional
# (e.g. a CloudFront domain); it defaults to the bucket's own URL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
