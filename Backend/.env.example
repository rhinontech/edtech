NODE_ENV=development
PORT=4000

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=edtech_admin
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Auth — must match admin-panel's JWT_SECRET exactly
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Default superadmin, created automatically on first `npm run db:setup`
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@edtech.local
SUPERADMIN_PASSWORD=ChangeMe123!

# Origin allowed to call this API directly (the admin-panel app)
CORS_ORIGIN=http://localhost:3000
