{
  "name": "backend",
  "version": "1.0.0",
  "description": "Admin panel backend — Express, Sequelize, PostgreSQL, JWT auth, RBAC",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate",
    "seed": "sequelize-cli db:seed:all",
    "seed:content": "node src/scripts/seedLandingContent.js",
    "db:create": "sequelize-cli db:create",
    "db:setup": "npm run db:create && npm run migrate && node src/utils/bootstrapSuperadmin.js"
  },
